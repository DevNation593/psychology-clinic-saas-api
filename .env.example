# App Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psic_clinic_dev?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/psic_clinic_test"

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Optional: dedicated secret for password reset tokens (defaults to JWT_ACCESS_SECRET)
# JWT_RESET_SECRET=
# Minutes of inactivity before a session expires (default 60)
SESSION_INACTIVITY_MINUTES=60

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Firebase Cloud Messaging (for push notifications)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FCM_PROJECT_ID=psychology-clinic-saas
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL=firebase-adminsdk@psychology-clinic-saas.iam.gserviceaccount.com

# Web Push to browsers (optional). Generate the pair with: npm run webpush:generate-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach about this sender
VAPID_SUBJECT=mailto:soporte@example.com

# Clinical data encryption (required in production). Comma-separated id:base64 entries with
# 32-byte keys; the first one encrypts, the others only decrypt. See docs/CLINICAL_DATA_PROTECTION.md
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLINICAL_ENCRYPTION_KEYS=

# Reminders Configuration
REMINDER_CHECK_INTERVAL_MINUTES=15
REMINDER_RULES_DEFAULT=24h,2h

# Clinical files (lab results, images, signed consents)
# Directory of the API server where they are kept, encrypted with CLINICAL_ENCRYPTION_KEYS.
# It must survive deployments and be part of the backups.
STORAGE_LOCAL_PATH=./storage

# Application URLs
FRONTEND_URL=http://localhost:4200
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:4200

# Transactional e-mail (password reset, invitations). Required in production:
# without it nobody can recover access. The API posts { from, to, subject, html, text }
# with a Bearer key, e.g. EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM="HCX Care <no-reply@example.com>"
# Lifetime of a password reset link (default 1h)
# JWT_RESET_EXPIRATION=1h

# Faktur connection. The URL, path and environment are the same for every clinic and are read
# only from here; each clinic stores its own API key, establishment and numbering.
FAKTUR_API_URL=https://api.faktur.ec
FAKTUR_INVOICE_PATH=/invoices
# TEST or PRODUCTION. Required: invoices are not issued without it.
FAKTUR_ENVIRONMENT=TEST
# Key used only by clinics that have not stored their own
FAKTUR_API_KEY=
FAKTUR_TIMEOUT_MS=15000

# Platform administrator. Read ONLY by `npm run platform:create-admin`, which creates the
# reserved "Plataforma" tenant (if missing) and one ADMIN user in it. The API itself does not read them.
# The password needs at least 8 characters; the script fails if the email already exists.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FIRST_NAME=
PLATFORM_ADMIN_LAST_NAME=
